+// ValuePool: interned (hash-consed) AbstractValues and value sets
+// =============================================================================
+//
+// The TS implementation treats AbstractValue objects and the per-variable
+// value Sets as immutable and shares them by reference between InferenceState
+// copies, so copying a state is just two shallow Map copies.  The Rust port
+// previously deep-copied these on every state clone/merge, which made this
+// pass's cost grow quadratically with function size (every basic-block visit
+// copies the whole state).
+//
+// Here the immutable AbstractValues and value sets are interned in a per-pass
+// pool and referred to by small Copy handles.  Because interning is canonical
+// (structurally equal values/sets get the same handle), handle equality is
+// exactly structural equality, so the state merge's "did anything change?"
+// test reduces to comparing handles, and repeated block visits that recreate
+// the same values hit the fast paths.  A state copy is a plain memcpy of two
+// tables of Copy entries, and dropping a state frees two allocations.  The
+// pool only grows (bounded by the distinct values/sets a function's analysis
+// produces) and is released when the pass finishes.
+
+/// Handle to an interned AbstractValue in a [ValuePool].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct AbsValueId(u32);
+
+/// Handle to an interned (sorted, deduplicated) set of ValueIds in a
+/// [ValuePool].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct ValueSetId(u32);
+
+const VALUE_KIND_COUNT: usize = 6;
+const VALUE_REASON_COUNT: usize = 12;
+
+fn value_kind_index(kind: ValueKind) -> usize {
+    match kind {
+        ValueKind::Mutable => 0,
+        ValueKind::Frozen => 1,
+        ValueKind::Primitive => 2,
+        ValueKind::MaybeFrozen => 3,
+        ValueKind::Global => 4,
+        ValueKind::Context => 5,
+    }
+}
+
+fn value_reason_index(reason: ValueReason) -> usize {
+    match reason {
+        ValueReason::KnownReturnSignature => 0,
+        ValueReason::State => 1,
+        ValueReason::ReducerState => 2,
+        ValueReason::Context => 3,
+        ValueReason::Effect => 4,
+        ValueReason::HookCaptured => 5,
+        ValueReason::HookReturn => 6,
+        ValueReason::Global => 7,
+        ValueReason::JsxCaptured => 8,
+        ValueReason::StoreLocal => 9,
+        ValueReason::ReactiveFunctionArgument => 10,
+        ValueReason::Other => 11,
+    }
+}
+
+struct ValuePool {
+    values: Vec<AbstractValue>,
+    /// Interning index for values with zero or one reason (the common case),
+    /// keyed by (kind, reason). Slot VALUE_REASON_COUNT is the empty-reason value.
+    simple_values: [Option<AbsValueId>; VALUE_KIND_COUNT * (VALUE_REASON_COUNT + 1)],
+    /// Interning index for values with two or more reasons, keyed by the kind
+    /// and the reasons in insertion order (the order is observable through
+    /// primary_reason, so it is part of the value's identity).
+    multi_values: FxHashMap<(usize, Box<[ValueReason]>), AbsValueId>,
+    /// Memoized merge_abstract_values results, keyed by (a, b) in argument
+    /// order (the merged reason order depends on the argument order).
+    merge_cache: FxHashMap<(AbsValueId, AbsValueId), AbsValueId>,
+    sets: Vec<Box<[ValueId]>>,
+    singleton_sets: FxHashMap<ValueId, ValueSetId>,
+    multi_sets: FxHashMap<Box<[ValueId]>, ValueSetId>,
+    /// Memoized set unions, keyed by the (smaller, larger) handle pair.
+    union_cache: FxHashMap<(ValueSetId, ValueSetId), ValueSetId>,
+}
+
+impl ValuePool {
+    fn new() -> Self {
+        ValuePool {
+            values: Vec::new(),
+            simple_values: [None; VALUE_KIND_COUNT * (VALUE_REASON_COUNT + 1)],
+            multi_values: FxHashMap::default(),
+            merge_cache: FxHashMap::default(),
+            sets: Vec::new(),
+            singleton_sets: FxHashMap::default(),
+            multi_sets: FxHashMap::default(),
+            union_cache: FxHashMap::default(),
+        }
+    }
+
+    fn get(&self, id: AbsValueId) -> &AbstractValue {
+        &self.values[id.0 as usize]
+    }
+
+    fn kind_of(&self, id: AbsValueId) -> ValueKind {
+        self.values[id.0 as usize].kind
+    }
+
+    /// Intern an AbstractValue, returning the handle of the canonical copy.
+    fn intern(&mut self, value: AbstractValue) -> AbsValueId {
+        if value.reason.len() <= 1 {
+            let reason_slot = value
+                .reason
+                .first()
+                .map_or(VALUE_REASON_COUNT, |r| value_reason_index(*r));
+            let slot = value_kind_index(value.kind) * (VALUE_REASON_COUNT + 1) + reason_slot;
+            if let Some(id) = self.simple_values[slot] {
+                return id;
+            }
+            let id = AbsValueId(self.values.len() as u32);
+            self.values.push(value);
+            self.simple_values[slot] = Some(id);
+            id
+        } else {
+            let key = (
+                value_kind_index(value.kind),
+                value.reason.iter().copied().collect::<Box<[ValueReason]>>(),
+            );
+            if let Some(&id) = self.multi_values.get(&key) {
+                return id;
+            }
+            let id = AbsValueId(self.values.len() as u32);
+            self.values.push(value);
+            self.multi_values.insert(key, id);
+            id
+        }
+    }
+
+    /// Intern the single-reason AbstractValue { kind, {reason} }.
+    fn intern_simple(&mut self, kind: ValueKind, reason: ValueReason) -> AbsValueId {
+        let slot = value_kind_index(kind) * (VALUE_REASON_COUNT + 1) + value_reason_index(reason);
+        if let Some(id) = self.simple_values[slot] {
+            return id;
+        }
+        self.intern(AbstractValue {
+            kind,
+            reason: hashset_of(reason),
+        })
+    }
+
+    /// Merge two abstract values, mirroring TS `mergeAbstractValues`.
+    /// Returns `a` itself when merging adds nothing to it.
+    fn merge_values(&mut self, a: AbsValueId, b: AbsValueId) -> AbsValueId {
+        if a == b {
+            return a;
+        }
+        if let Some(&merged) = self.merge_cache.get(&(a, b)) {
+            return merged;
+        }
+        let (a_kind, b_kind) = (self.kind_of(a), self.kind_of(b));
+        let kind = merge_value_kinds(a_kind, b_kind);
+        let merged = if kind == a_kind
+            && kind == b_kind
+            && is_superset(&self.get(a).reason, &self.get(b).reason)
+        {
+            a
+        } else {
+            let mut reason = self.get(a).reason.clone();
+            for r in &self.get(b).reason {
+                reason.insert(*r);
+            }
+            self.intern(AbstractValue { kind, reason })
+        };
+        self.merge_cache.insert((a, b), merged);
+        merged
+    }
+
+    fn set(&self, id: ValueSetId) -> &[ValueId] {
+        &self.sets[id.0 as usize]
+    }
+
+    fn singleton_set(&mut self, value_id: ValueId) -> ValueSetId {
+        if let Some(&id) = self.singleton_sets.get(&value_id) {
+            return id;
+        }
+        let id = ValueSetId(self.sets.len() as u32);
+        self.sets.push(Box::new([value_id]));
+        self.singleton_sets.insert(value_id, id);
+        id
+    }
+
+    /// Intern an already sorted, deduplicated, non-empty list of ValueIds.
+    fn intern_sorted_set(&mut self, sorted: &[ValueId]) -> ValueSetId {
+        debug_assert!(!sorted.is_empty());
+        if let [single] = sorted {
+            return self.singleton_set(*single);
+        }
+        if let Some(&id) = self.multi_sets.get(sorted) {
+            return id;
+        }
+        let id = ValueSetId(self.sets.len() as u32);
+        let boxed: Box<[ValueId]> = sorted.into();
+        self.sets.push(boxed.clone());
+        self.multi_sets.insert(boxed, id);
+        id
+    }
+
+    fn set_union(&mut self, a: ValueSetId, b: ValueSetId) -> ValueSetId {
+        if a == b {
+            return a;
+        }
+        let key = if a.0 <= b.0 { (a, b) } else { (b, a) };
+        if let Some(&u) = self.union_cache.get(&key) {
+            return u;
+        }
+        let sa = self.set(a);
+        let sb = self.set(b);
+        let mut merged: Vec<ValueId> = Vec::with_capacity(sa.len() + sb.len());
+        let (mut i, mut j) = (0, 0);
+        while i < sa.len() && j < sb.len() {
+            match sa[i].0.cmp(&sb[j].0) {
+                std::cmp::Ordering::Less => {
+                    merged.push(sa[i]);
+                    i += 1;
+                }
+                std::cmp::Ordering::Greater => {
+                    merged.push(sb[j]);
+                    j += 1;
+                }
+                std::cmp::Ordering::Equal => {
+                    merged.push(sa[i]);
+                    i += 1;
+                    j += 1;
+                }
+            }
+        }
+        merged.extend_from_slice(&sa[i..]);
+        merged.extend_from_slice(&sb[j..]);
+        let u = self.intern_sorted_set(&merged);
+        self.union_cache.insert(key, u);
+        u
+    }
+
+}
